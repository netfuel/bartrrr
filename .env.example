# Bartrrr web app environment. Copy to .env.local for development.
# On Cloudflare Pages, set these under Settings → Variables and Secrets
# (Production and Preview), then redeploy: Vite inlines them at build time.
#
# Every VITE_* value ships to the browser. Never put a secret here
# (no service-role key, no OAuth client secrets, no VAPID private key).

# ── Required (unless VITE_DEMO_MODE=true) ────────────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" key. Safe in the browser: Row Level Security guards the data.
VITE_SUPABASE_ANON_KEY=

# ── Recommended ──────────────────────────────────────────────────────────────
# Canonical public origin used for canonical/og:url tags
VITE_SITE_URL=https://bartrrr.app

# ── Optional ─────────────────────────────────────────────────────────────────
# Web Push public key (pair with VAPID_PRIVATE_KEY in Supabase function secrets).
# Generate a pair: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Comma-separated OAuth buttons to show. Default: all configured (google,apple).
# e.g. VITE_AUTH_PROVIDERS=google while Apple setup is pending.
VITE_AUTH_PROVIDERS=

# ── Demo / development only ──────────────────────────────────────────────────
# "true" loads sample neighbors and listings and shows a "log in as" picker.
# Never set in production. With no Supabase vars, demo runs fully offline.
VITE_DEMO_MODE=
# Only for demo mode against a Supabase project seeded with *@bartrrr.demo users
VITE_DEMO_PASSWORD=

# ── Build only (not read by the app) ─────────────────────────────────────────
# "true" emits hidden sourcemaps for an error-tracker upload step. Delete
# them from dist/ before deploying; anything in dist/ is public.
SOURCEMAP=
