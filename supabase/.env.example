# Secrets read by supabase/config.toml via env() when running the local
# Supabase stack (`supabase start`) or `supabase config push`.
# Copy to supabase/.env (gitignored) and fill in. Never commit real values.
# On the hosted project, set the same values in Dashboard → Authentication → Providers.

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Apple Developer → Identifiers → Services ID (e.g. app.bartrrr.signin)
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
# JWT client secret generated from your Sign in with Apple .p8 key (expires every 6 months)
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Edge function secrets (`supabase secrets set --env-file supabase/.env`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bartrrr.app
ALLOWED_ORIGINS=https://bartrrr.app,https://www.bartrrr.app,http://localhost:5173

# Leave the remaining keys present so config.toml's env() references resolve
OPENAI_API_KEY=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
S3_HOST=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
